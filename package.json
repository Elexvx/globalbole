{
  "name": "politica-studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "content": "node scripts/content.mjs",
    "build": "node scripts/content.mjs && node scripts/optimize-images.mjs && next build && node scripts/finalize-export.mjs",
    "optimize:images": "node scripts/content.mjs && node scripts/optimize-images.mjs",
    "start": "serve out -l 4173",
    "preview": "serve out -l 4174",
    "lint": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check:export": "node scripts/check-export.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.42.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
