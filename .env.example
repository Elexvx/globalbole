# Optional canonical override. Defaults to the established production domain.
# Keep the production URL on preview builds; this value is public, not a secret.
NEXT_PUBLIC_SITE_URL=https://www.globalbole.com
# Optional public read-only JSON endpoint. Never include credentials or secrets.
# Defaults to /data/v1/articles.json. See docs/frontend-api.md before changing.
# NEXT_PUBLIC_ARTICLES_URL=https://api.example.com/v1/articles
