{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/about",
      "destination": "/zh-CN/about/",
      "permanent": true
    },
    {
      "source": "/authors",
      "destination": "/zh-CN/authors/",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/zh-CN/contact/",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/zh-CN/privacy/",
      "permanent": true
    },
    {
      "source": "/issues",
      "destination": "/zh-CN/issues/",
      "permanent": true
    },
    {
      "source": "/all-news",
      "destination": "/zh-CN/all-news/",
      "permanent": true
    },
    {
      "source": "/all-news/:page",
      "destination": "/zh-CN/all-news/:page/",
      "permanent": true
    },
    {
      "source": "/issue/:slug",
      "destination": "/zh-CN/issue/:slug/",
      "permanent": true
    },
    {
      "source": "/post/:slug(zh-cn-[a-z0-9-]+)",
      "destination": "/zh-CN/post/:slug/",
      "permanent": true
    },
    {
      "source": "/post/:slug(zh-tw-[a-z0-9-]+)",
      "destination": "/zh-TW/post/:slug/",
      "permanent": true
    },
    {
      "source": "/post/:slug(en-[a-z0-9-]+)",
      "destination": "/en/post/:slug/",
      "permanent": true
    },
    {
      "source": "/post/:slug(ru-[a-z0-9-]+)",
      "destination": "/ru/post/:slug/",
      "permanent": true
    },
    {
      "source": "/post/:slug(fr-[a-z0-9-]+)",
      "destination": "/fr/post/:slug/",
      "permanent": true
    },
    {
      "source": "/category/world",
      "destination": "/zh-CN/all-news/",
      "permanent": true
    },
