      "permanent": true
    },
    {
      "source": "/tag/:slug",
      "destination": "/zh-CN/tag/:slug/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/optimized-assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
